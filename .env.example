# ---------------------------------------------------------------------------
# Alloca — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Database connection string.
# Development (default) uses SQLite — no server required:
DATABASE_URL="file:./db/alloca.db"
# Production example (PostgreSQL) — also change the provider in prisma/schema.prisma:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/alloca"

# Secret used to sign session JSON Web Tokens.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# How long a session cookie stays valid, in days.
SESSION_MAX_AGE_DAYS="30"

# Public base URL of the app (used by the Playwright e2e suite).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Credentials created by `npm run db:seed` for the demo account.
SEED_DEMO_EMAIL="demo@alloca.app"
SEED_DEMO_PASSWORD="allowance123"
